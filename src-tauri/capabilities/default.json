{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Base capabilities for Milo's desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "$HOME/**" }]
    }
  ]
}
